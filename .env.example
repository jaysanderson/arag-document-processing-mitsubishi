# Copy this file to .env and fill in what you need:  cp .env.example .env
#
# Every comment is on its own line ON PURPOSE. The .env parser treats everything after
# `=` as the value, including a trailing `# comment`, so `LOG_LEVEL=info  # a note`
# becomes the literal value "info  # a note" and fails validation at boot. Keep comments
# above the key they describe, never after it.

# ── Progress Agentic RAG connection (required unless ARAG_MOCK=1) ─────────────
# Knowledge Box id (uuid).
ARAG_KB_ID=
# KB service-account token, sent as X-NUCLIA-SERVICEACCOUNT. Never commit the real value.
ARAG_API_KEY=
# Zone slug; or set ARAG_BASE_URL to override the host entirely. The Mitsubishi Electric
# Knowledge Box (slug mitsubishi-electric-orders) lives in the Sydney zone.
ARAG_REGION=aws-ap-southeast-2-1
#ARAG_BASE_URL=https://aws-ap-southeast-2-1.dp.progress.cloud/api/v1
# Multimodal model used for visual extraction; empty = the Knowledge Box default. Left empty
# here: chatgpt-azure-4o, the product's usual choice, is not offered in the Sydney zone.
ARAG_GENERATIVE_MODEL=
# predict (cross-encoder, grounded) | noop (fast).
ARAG_RERANKER=predict
# Per-request timeout to ARAG in ms; visual extraction of a large page can be slow.
ARAG_TIMEOUT_MS=60000
# 1 = use the in-process mock ARAG, so the product runs with no credentials at all.
ARAG_MOCK=0

# ── Document Processing specifics ────────────────────────────────────────────
# ARAG extract-strategy id applied to image and PDF uploads (ingestion-time visual-LLM
# extraction). The deployed build's name ARAG_EXTRACT_STRATEGY is still honoured.
DIP_EXTRACT_STRATEGY=
# Max upload size in bytes (25 MB). Legacy name MAX_UPLOAD_BYTES is still honoured.
DIP_MAX_UPLOAD_BYTES=26214400
# Documents older than this are what POST /api/v1/admin/purge deletes when the request
# does not name its own threshold.
DIP_RETENTION_DAYS=30
# 1 = run that purge on a schedule instead of waiting for an operator.
DIP_AUTO_PURGE=0
# How often the automatic purge runs, in hours.
DIP_PURGE_INTERVAL_HOURS=24
#
# Every variable in this file is only a *default*. An operator can edit any of them in the
# product (Settings, or PATCH /api/v1/admin/settings); the stored value overrides the
# environment, takes effect without a restart and is audited. POST
# /api/v1/admin/settings/reset puts a field back on its environment default.

# ── SAP order hand-off (all optional) ────────────────────────────────────────
# The `sap-c4c` and `sap-s4` exports build a sales-order request body from a purchase-order
# record. These are the values no customer order carries. The product never calls SAP.
# Sales document type: ProcessingTypeCode in Sales Cloud, SalesOrderType in S/4HANA.
SAP_ORDER_TYPE=OR
# Sales area. Left empty, the fields are omitted and SAP applies its own determination.
SAP_SALES_ORG=
SAP_DISTRIBUTION_CHANNEL=
SAP_DIVISION=

# ── Service ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# JSON stores: documents, jobs, extraction configs. Also holds branding/ assets.
DATA_DIR=./data
PUBLIC_URL=http://localhost:8080

# ── White-label branding (all optional; see docs/developer/white-label.md) ────
# This checkout is set up for Mitsubishi Electric; clear these to get the unbranded product.
# Header, page titles and the demo's product name.
BRAND_PRODUCT_NAME=Mitsubishi Electric
# Short line beside the product name.
BRAND_TAGLINE=Orders in, validated records out
# Absolute URL, or /branding/logo.svg served from DATA_DIR/branding/. The three-diamond
# mark ships in public/brand/, so it is in the image and needs no volume.
BRAND_LOGO_URL=/brand/mitsubishi-electric.svg
# Any CSS colour; overrides the brand CSS variables in both UIs. Written as rgb() because a
# hex value would put a "#" in this file (see the note at the top). This is #e60012.
BRAND_PRIMARY_COLOR=rgb(230,0,18)
BRAND_ACCENT_COLOR=
# 1 = show "Built on Progress Agentic RAG"; 0 = hide it. Hiding the credit does not
# remove the Apache-2.0 attribution obligations in LICENSE/NOTICE.
BRAND_POWERED_BY=1
# Replaces the default footer line.
BRAND_FOOTER_TEXT=
# Where the "API docs" button points (default /api/v1/docs).
BRAND_DOCS_URL=
# Partner support link.
BRAND_SUPPORT_URL=

# ── Security ─────────────────────────────────────────────────────────────────
# Required to open /admin and /api/v1/admin/*. Generate: openssl rand -hex 24
ADMIN_TOKEN=
# Comma-separated. When set, /api/v1 requires X-API-Key (the demo UI uses a session
# cookie). Strongly recommended for any internet-facing deployment: without it reads and
# uploads are open, rate-limited only. DELETEs and config creation always require an API
# key, the admin token, or a session cookie from POST /api/v1/session.
API_KEYS=
# Comma-separated CORS origins; empty = same-origin only.
ALLOWED_ORIGINS=
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
# Which proxy header identifies the client IP for rate limiting:
# fly (default: trust Fly-Client-IP) | xff (first X-Forwarded-For) | none
TRUST_PROXY=fly
# Hard HTTP body cap. Uploads are additionally capped by DIP_MAX_UPLOAD_BYTES.
MAX_BODY_BYTES=26214400
